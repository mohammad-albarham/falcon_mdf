# Generated .gitignore for falcon_mdf

# Rust build artifacts
/target/
**/target/

# Dependency directories
# Note: libraries typically do NOT ignore Cargo.lock; keep it if you want reproducible builds.
#/Cargo.lock

# IDE / Editor files
/.vscode/
.idea/
*.swp
*~
.DS_Store

# Fuzzing artifacts (the harness itself is checked in; its output is not)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Logs and temporary files
*.log

# Binary artifacts
*.rlib
*.so
*.dylib
*.exe

# Example outputs
/out.csv

# Measurement files are never committed. They are other vendors' files, this
# repo does not redistribute them, and they are large; `scripts/fetch_*.sh`
# pulls them into test_data/ and only the values they decode to — the JSON
# ground truth under tests/data/ — is checked in. The extension patterns are
# the backstop for a file landing outside test_data/, as one dropped in the
# repo root or copied into a fuzz corpus by hand would.
/test_data/*
*.mf4
*.MF4
*.mdf
*.MDF
!/test_data/smoke.mf4

# Python virtual environment
.venv/
__pycache__/
*.pyc

*.csv
# Agent worktrees, created per-session under .claude/
/.claude/worktrees/

# Local agent tool settings
/.qwen/
/.opencode/
/opencode.json


AUDIT.md
.agent_reports/
